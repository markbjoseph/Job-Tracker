// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//what it does
//blueprint for database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username      String
  email     String   @unique
  password  String
  avatar    String?   // profile picture as a small data URL, null = default icon

  boards    Board[]
  workspaces  Workspace[]
  workspaceMemberships WorkspaceMember[]
  activities  Activity[]
  loginEvents LoginEvent[]

  createdAt DateTime @default(now())
}

model Board {
  id        Int      @id @default(autoincrement())
  title     String

  ownerId   Int
  owner      User @relation(fields: [ownerId], references: [id])

  // every board lives inside one workspace
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  lists     List[]

  createdAt DateTime @default(now())
}

model List {
  id        Int      @id @default(autoincrement())
  title     String
  position  Int

  boardId   Int
  board     Board @relation(fields: [boardId], references: [id])

  cards     Card[]
}

model Card {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  position    Int

  // picture inside the card, as a data URL (null = no picture)
  image       String?
  // where the picture sits in the description, which the text wraps around:
  // imageX: 0 = on the left (text on its right), 100 = on the right; imageY: how far down, in rem
  imageX      Float    @default(0)
  imageY      Float    @default(0)

  listId      Int
  list         List @relation(fields: [listId], references: [id])
}

// a workspace holds many boards; sharing a workspace shares all of its boards
model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?  // workspace picture as a small data URL, null = no picture

  ownerId   Int
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  boards    Board[]
  members   WorkspaceMember[]
  activities Activity[]

  createdAt DateTime @default(now())
}

// one row per person a workspace has been shared with
model WorkspaceMember {
  id          Int      @id @default(autoincrement())

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // what they're allowed to do: "admin" (also manage people), "member" (edit), "viewer" (read only)
  role        String   @default("member")

  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
}

// one row per successful login, used for "Recent devices" on the account page
model LoginEvent {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String   // browser and operating system the login came from
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// one row per change someone makes in a workspace, shown in Activity on the Manage workspace page
model Activity {
  id          Int      @id @default(autoincrement())

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // who did it
  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      String   // "created", "updated", "deleted", "moved", "added", "removed"
  targetType  String   // "board", "list", "card", "member", "workspace"
  targetName  String   // name at the time, so it still reads right after a rename or delete

  // extra detail, e.g. which board a card is on or what something was renamed to
  details     String?

  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}
